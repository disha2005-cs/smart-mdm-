# Frontend Environment Variables

# Backend API URL
# For localhost use:
# VITE_API_URL=http://localhost:8000/api/v1

# For ngrok use (replace with your backend ngrok URL):
# VITE_API_URL=https://your-backend-url.ngrok-free.app/api/v1

# Default (localhost)
VITE_API_URL=http://localhost:8000/api/v1
