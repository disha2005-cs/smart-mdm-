# Base URL of the backend API.
#
# Local development against a backend on port 8000:
VITE_API_URL=http://localhost:8000/api/v1

# Deployed behind a reverse proxy that serves both the UI and the API
# (this is what the Docker image builds with) - same origin, no CORS:
# VITE_API_URL=/api/v1

# Separate API host:
# VITE_API_URL=https://api.yourdomain.com/api/v1
