# Database Configuration
# PostgreSQL connection string with pgvector extension
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/midday_meal_db

# JWT Authentication
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
PROJECT_NAME=Smart Mid-Day Meal System
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS Origins (comma-separated)
# Add all domains that will access your API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=uploads

# Face Recognition Settings (Optional - uses defaults if not set)
# FACE_DETECTION_THRESHOLD=0.5
# FACE_MATCHING_THRESHOLD=0.6
# FACE_MARKING_THRESHOLD=0.65

# Logging Level (Optional)
# LOG_LEVEL=INFO

# Production Settings (Uncomment for production)
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
