# Backend configuration (manual / non-Docker setup).
# With Docker Compose these come from the root .env instead.
#
#   cp .env.example .env

# --- Database (required) ---------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mdm
# Managed (Neon, RDS, Supabase, ...):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (required) -------------------------------------------------------
# At least 32 characters; the app refuses to start with anything shorter.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- First administrator (used by seed.py) ---------------------------------
SEED_ADMIN_EMPLOYEE_ID=GOV-001
SEED_ADMIN_EMAIL=admin@pmposhan.gov.in
SEED_ADMIN_PASSWORD=admin123

# --- Photo storage (optional) ----------------------------------------------
# Leave blank to store student photos on local disk under uploads/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- CORS (optional) -------------------------------------------------------
# Browser origins allowed to call this API directly, comma separated.
# localhost:5173 / :5174 / :3000 / :8080 are always allowed.
# BACKEND_CORS_ORIGINS=https://app.example.com
