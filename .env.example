# ---------------------------------------------------------------------------
# Docker Compose configuration
#
#   cp .env.example .env
#   # fill in DATABASE_URL and JWT_SECRET_KEY below
#   docker compose up --build
# ---------------------------------------------------------------------------

# REQUIRED. Any PostgreSQL database.
#
# Managed Postgres (Neon, RDS, Supabase, ...) - copy the connection string from
# your provider's dashboard and keep the ?sslmode=require:
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require
#
# Or, to use the Postgres container bundled with this project, use the line
# below instead and start it with:  docker compose --profile localdb up --build
# DATABASE_URL=postgresql://mdm:mdm_local_password@db:5432/mdm

# REQUIRED. Signs every login token; at least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Auth ------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- First administrator ---------------------------------------------------
# Created on first boot, and only when no government admin exists yet. If you
# already have one, these are ignored.
SEED_ADMIN_EMPLOYEE_ID=GOV-001
SEED_ADMIN_EMAIL=admin@pmposhan.gov.in
SEED_ADMIN_PASSWORD=admin123

# --- Ports -----------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Bundled Postgres (only used with --profile localdb) -------------------
POSTGRES_USER=mdm
POSTGRES_PASSWORD=mdm_local_password
POSTGRES_DB=mdm
POSTGRES_PORT=5432

# --- Photo storage (optional) ----------------------------------------------
# Without these, student photos are written to the `uploads` volume and served
# by the backend. Fill them in to store photos in S3 instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- CORS (optional) -------------------------------------------------------
# Only needed if a browser app on another origin calls the API directly. The
# bundled frontend is same-origin and needs nothing here.
# BACKEND_CORS_ORIGINS=https://app.example.com,https://admin.example.com
